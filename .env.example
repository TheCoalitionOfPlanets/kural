# Copy to .env and fill in. `.env` is gitignored; this file is not.
#
#     cp .env.example .env
#
# NOTHING LOADS THIS AUTOMATICALLY. The workers read the real process
# environment (os.environ), so the values have to actually be exported before
# you start anything:
#
#     bash/zsh      set -a; source .env; set +a
#     git-bash      set -a; . ./.env; set +a
#     PowerShell    Get-Content .env | % { if ($_ -match '^\s*([^#=]+)=(.*)$') {
#                     [Environment]::SetEnvironmentVariable($m[1].Trim(), $m[2].Trim()) } }
#
# A key set only in .env and never exported looks exactly like no key at all:
# the startup line says "ElevenLabs off" and international turns get dropped.


# ---------------------------------------------------------------------------
# ElevenLabs — the international ear and voice
# ---------------------------------------------------------------------------
# Required for any language the local Indic models cannot handle: Spanish,
# Russian, Japanese, Arabic, and the rest. Without it, Indic and English are
# completely unaffected — international turns are reported as unavailable
# rather than mistranscribed.
#
# Needs both text-to-speech and speech-to-text permission on the key.
# Verify it end to end before relying on it:
#
#     venv/Scripts/python.exe pipeline/tests/check_elevenlabs.py
#
# The variable NAME is configurable as elevenlabs.api_key_env in
# pipeline/config/realtime.yaml; this is the default.
ELEVENLABS_API_KEY=sk_123a52217263542a9019256433911f3c848acf75998b3808


# ---------------------------------------------------------------------------
# Hugging Face — only needed while downloading models
# ---------------------------------------------------------------------------
# Two of the models are gated and download.sh cannot fetch them anonymously:
#   google/gemma-3-4b-it        accept the Gemma licence on the model page
#   ARTPARK-IISc/SraVaani-1.0   request access on the model page
#
# `hf auth login` does the same job and is the better option if you have the
# CLI. Not read at runtime — only by download.sh.
HF_TOKEN=

# Where Hugging Face caches downloads. Leave unset unless you want it off the
# system drive. If it points at a drive that is not mounted, proc.py detects
# that and falls back to an in-repo cache rather than failing the run.
# HF_HOME=


# ---------------------------------------------------------------------------
# Setup — only if download.sh cannot find the right interpreters
# ---------------------------------------------------------------------------
# The three venvs need Python 3.14 (root) and 3.12 (reasoning, tts). Set these
# to absolute paths only when they are not on PATH under those names.
# PYTHON_314=
# PYTHON_312=


# ---------------------------------------------------------------------------
# Web front end
# ---------------------------------------------------------------------------
# NOTE: this one does NOT belong here. Next.js reads its own env files, and
# NEXT_PUBLIC_* values are baked in at build time — so it lives in
# web/.env.local (see web/.env.example) and a value set here is ignored.
#
#     NEXT_PUBLIC_PIPELINE_URL=http://127.0.0.1:8000
